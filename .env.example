# Neon Postgres — use the POOLED connection string (pgbouncer endpoint)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/gearify?sslmode=require

# JWT secret for auth tokens (Phase 2) — generate a random 64-char hex string
JWT_SECRET=change_me_to_a_random_secret

# Base URL for the API (used by Next.js to call Flask)
# Local dev: http://localhost:5328  |  Production: https://your-domain.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5328
